#!/bin/sh
# Copyright 2015 Brent Longborough
# Please read gitinfo2.pdf for licencing and other details
# -----------------------------------------------------
# Post-{commit,checkout,merge} hook for the gitinfo2 package
#
# prefixes=". test docs"    # Example for multiple version.tex files
prefixes="src"              # Default --- in the working copy root

# gitinfo2 auto-discovers .git/gitHeadInfo.gin by walking up from the
# LaTeX source directory, so this is written once at the repo root.
FIRSTTAG=$(git describe --tags --always --dirty='-*' 2>/dev/null)
RELTAG=$(git describe --tags --long --always --dirty='-*' --match 'v[0-9]*' 2>/dev/null)
git --no-pager log -1 --date=short --decorate=short \
	--pretty=format:"\usepackage[%
		shash={%h},
		lhash={%H},
		authname={%an},
		authemail={%ae},
		authsdate={%ad},
		authidate={%ai},
		authudate={%at},
		commname={%cn},
		commemail={%ce},
		commsdate={%cd},
		commidate={%ci},
		commudate={%ct},
		refnames={%d},
		firsttagdescribe={$FIRSTTAG},
		reltag={$RELTAG}
	]{gitexinfo}" HEAD > .git/gitHeadInfo.gin

for pref in $prefixes
	do
	version=$(git describe --tags --always | sed 's/^v//')
	cat > $pref/version.tex <<-EOV
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	%%%%%% Git version info %%%%%%
	%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	% Auto-generated by hooks/post-{commit,checkout,merge}; do not edit by hand.
	\newcommand{\currentversion}{$version}
	EOV
	done
